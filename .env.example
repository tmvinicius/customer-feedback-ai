# Copie para .env e preencha. Nunca versione o .env (AGENTS.md, regra 6).

# Chave da API da Anthropic. Deixe vazio aqui.
ANTHROPIC_API_KEY=

# Modelos LLM (AGENTS.md, seção 13).
LLM_MODEL_CHEAP=claude-haiku-5-5
LLM_MODEL_PREMIUM=claude-sonnet-5-5
LLM_MODEL_DRAFT=claude-sonnet-5-5

# Teto de gasto do projeto e limite de aprovação por job, em US$ (seção 16).
LLM_BUDGET_USD=30
LLM_JOB_APPROVAL_THRESHOLD_USD=5

# Envio de texto do corpus a um LLM externo (rótulos silver, avaliação com LLM).
# Mantenha false até G1 autorizar o envio (AGENTS.md, regra 10).
ALLOW_EXTERNAL_LLM=false

# Identificação de quem anota o gold set, gravada em cada rótulo.
ANNOTATOR_ID=anotador_1

# Índice de casos da demo: synthetic ou real. "real" exige autorização G1.
CASES_INDEX=synthetic

# Diretório de dados, relativo à raiz do repositório.
DATA_DIR=data
